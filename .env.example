# Supabase (server uses the service-role key; never expose it to the client)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=you@example.com

# Admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Server secret for PIN hashing (openssl rand -base64 32). Same value in every
# environment that shares a DB. Back it up: losing it locks every shop out.
PIN_PEPPER=

# HMAC secret for barista session cookies (falls back to ADMIN_SECRET)
SHOP_SESSION_SECRET=

# Fallback support email on /expired when none is set in /admin/broadcast
SUPPORT_EMAIL=

# Monthly subscription price in TND, used for admin MRR (default 25)
NEXT_PUBLIC_MONTHLY_PRICE_TND=25

# Dev only: this machine's LAN IP, so QR codes made on localhost open on a phone
NEXT_PUBLIC_DEV_LAN_IP=
